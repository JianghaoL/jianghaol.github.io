---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/blog/blog.css';
import { useTranslations, langPaths, type Lang } from '../../../i18n/utils';
import { getPosts, postUrl } from '../../../lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const posts = (await getPosts(lang)).map((p) => ({
  id: p.slug,
  title: p.data.cardTitle ?? p.data.title,
  category: p.data.category,
  date: p.data.date,
  excerpt: p.data.excerpt,
  fullExcerpt: p.data.fullExcerpt ?? p.data.excerpt,
  image: p.data.image ?? '',
  tags: p.data.tags ?? [],
  detailPage: postUrl(lang, p.slug),
}));
const copy = {
  readLabel: t('blog.card.read'),
  postSingular: t('blog.count.one'),
  postPlural: t('blog.count.many'),
  locale: lang === 'zh' ? 'zh-CN' : 'en-US',
};
const json = JSON.stringify({ posts, copy }).replace(/</g, '\\u003c');
---
<BaseLayout lang={lang} active="blog" title={`${t('meta.titleSuffix')} - ${t('blog.hero.title')}`}
  scripts={['/js/blog/blog.js']}>
<!-- Blog Hero Section -->
<section id="blog-hero" class="blog-hero">
  <div class="blog-hero-content">
    <h1>{t('blog.hero.title')}</h1>
    <p class="blog-subtitle">{t('blog.hero.subtitle')}</p>
  </div>
</section>

<!-- Blog Content Wrapper -->
<div class="blog-content-wrapper">
  
  <!-- Table of Contents -->
  <aside class="blog-toc" id="blog-toc" aria-label={t('blog.toc.aria')}>
    <div class="toc-header">
      <svg class="toc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="8" y1="6" x2="21" y2="6"></line>
        <line x1="8" y1="12" x2="21" y2="12"></line>
        <line x1="8" y1="18" x2="21" y2="18"></line>
        <line x1="3" y1="6" x2="3.01" y2="6"></line>
        <line x1="3" y1="12" x2="3.01" y2="12"></line>
        <line x1="3" y1="18" x2="3.01" y2="18"></line>
      </svg>
      <h2>{t('blog.toc.heading')}</h2>
    </div>
    <nav class="toc-links" id="toc-links">
      <!-- Generated by JavaScript -->
    </nav>
  </aside>

  <!-- Blog Grid -->
  <section class="blog-section">
    <div class="blog-grid" id="blog-grid">
      <!-- Cards are rendered by /js/blog/blog.js from the JSON below -->
    </div>
  </section>
  
</div><!-- End blog-content-wrapper -->

<script type="application/json" id="blog-data" set:html={json}></script>
</BaseLayout>
