---
/* Stub page for an old address. `target` = fixed destination; otherwise the
   visitor is sent to /en/ or /zh/ + the same path by /js/language-redirect.js. */
interface Props { path: string; target?: string | null }
const { path, target } = Astro.props;
const fallback = target ?? `/en/${path}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jianghao Li</title>
  {target
    ? <meta http-equiv="refresh" content={`0; url=${target}`}>
    : <script is:inline src="/js/language-redirect.js"></script>}
  <link rel="canonical" href={fallback}>
  <meta name="robots" content="noindex">
</head>
<body>
  <p><a href={fallback}>{fallback}</a></p>
</body>
</html>
