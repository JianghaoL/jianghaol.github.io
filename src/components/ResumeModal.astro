---
import { useTranslations, type Lang } from '../i18n/utils';
const t = useTranslations(Astro.props.lang as Lang);
---
<!-- Resume Modal Overlay -->
<div id="resume-modal-overlay" 
     class="resume-modal-overlay" 
     role="dialog" 
     aria-modal="true" 
     aria-labelledby="resume-modal-title"
     aria-hidden="true">
  <div class="resume-modal">
    <!-- Modal Header -->
    <header class="resume-modal-header">
      <h2 id="resume-modal-title" class="resume-modal-title">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span>{t('resume.title')}</span>
      </h2>
      <button type="button" 
              class="resume-modal-close" 
              aria-label="Close resume">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>
    
    <!-- Resume Content (HTML version - easily updatable) -->
    <div class="resume-modal-content">
      <div class="resume-html-content">
        <!-- Personal Info -->
        <h2>{t('resume.name')}</h2>
        <p class="resume-role">{t('resume.role')}</p>
        
        <div class="resume-contact-info">
          <span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{t('resume.location')}</span>
          </span>
          <span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>{t('resume.email')}</span>
          </span>
        </div>
        
        <!-- Education -->
        <h3>{t('resume.education.heading')}</h3>
        <div class="resume-experience-item">
          <h4>{t('resume.education.school')}</h4>
          <p class="resume-date">{t('resume.education.date')}</p>
          <ul>
            <li>{t('resume.education.item1')}</li>
            <li>{t('resume.education.item2')}</li>
            <li>{t('resume.education.item3')}</li>
          </ul>
        </div>
        
        <!-- Skills -->
        <h3>{t('resume.skills.heading')}</h3>
        <div class="resume-skills-grid">
          <div class="resume-skill-category">
            <h4>{t('resume.skills.cat1')}</h4>
            <div class="resume-skill-tags">
              <span class="resume-skill-tag">Unity</span>
              <span class="resume-skill-tag">Unreal Engine</span>
              <span class="resume-skill-tag">Game Design</span>
            </div>
          </div>
          <div class="resume-skill-category">
            <h4>{t('resume.skills.cat2')}</h4>
            <div class="resume-skill-tags">
              <span class="resume-skill-tag">C#</span>
              <span class="resume-skill-tag">C++</span>
              <span class="resume-skill-tag">Python</span>
              <span class="resume-skill-tag">Java</span>
            </div>
          </div>
          <div class="resume-skill-category">
            <h4>{t('resume.skills.cat3')}</h4>
            <div class="resume-skill-tags">
              <span class="resume-skill-tag">FMOD</span>
              <span class="resume-skill-tag">Wwise</span>
              <span class="resume-skill-tag">Studio One</span>
              <span class="resume-skill-tag">Logic Pro</span>
            </div>
          </div>
          <div class="resume-skill-category">
            <h4>{t('resume.skills.cat4')}</h4>
            <div class="resume-skill-tags">
              <span class="resume-skill-tag">Git</span>
              <span class="resume-skill-tag">Perforce</span>
              <span class="resume-skill-tag">Procreate</span>
            </div>
          </div>
        </div>
        
        <!-- Experience/Projects section -->
        <h3>{t('resume.focus.heading')}</h3>
        <div class="resume-experience-item">
          <h4>{t('resume.focus.title1')}</h4>
          <p>{t('resume.focus.desc1')}</p>
        </div>
        <div class="resume-experience-item">
          <h4>{t('resume.focus.title2')}</h4>
          <p>{t('resume.focus.desc2')}</p>
        </div>
        <div class="resume-experience-item">
          <h4>{t('resume.focus.title3')}</h4>
          <p>{t('resume.focus.desc3')}</p>
        </div>
      </div>
    </div>
    
    <!-- Modal Footer with Download Button -->
    <footer class="resume-modal-footer">
      <a href={t('resume.file')}
         download={t('resume.fileName')}
         class="btn-download-resume">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>{t('resume.download')}</span>
      </a>
    </footer>
  </div>
</div>
